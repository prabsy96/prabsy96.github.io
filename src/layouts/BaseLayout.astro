---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import '../styles/global.css';
import '../styles/layout.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
  additionalStructuredData?: Record<string, unknown> | null;
}

const {
  title,
  description = 'Personal research website of Prabhu Vellaisamy',
  wide = true,
  image = '/assets/profile-headshot.jpeg',
  ogType = 'website',
  additionalStructuredData = null,
} = Astro.props;
const fullTitle =
  title === 'Home'
    ? 'Prabhu Vellaisamy | NVIDIA Silicon CoDesign Engineer & CMU PhD'
    : `${title} | Prabhu Vellaisamy`;
const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(image, Astro.site);
const personImageUrl = new URL('/assets/profile-headshot.jpeg', Astro.site);
const personId = new URL('/#person', Astro.site);
const pageDescription = description;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const siteKeywords = [
  'Prabhu Vellaisamy',
  'Carnegie Mellon University',
  'CMU ECE',
  'LLM inference optimization',
  'hardware accelerators',
  'deep learning accelerators',
  'neuromorphic computing',
  'Temporal Neural Networks',
  'unary computing',
  'VLSI',
  'computer architecture',
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId.toString(),
      name: 'Prabhu Vellaisamy',
      givenName: 'Prabhu',
      familyName: 'Vellaisamy',
      url: Astro.site?.toString(),
      image: personImageUrl.toString(),
      email: 'pvellais@andrew.cmu.edu',
      jobTitle: [
        'Silicon CoDesign Engineer',
        'PhD Candidate in Electrical and Computer Engineering',
      ],
      description:
        'Silicon CoDesign Engineer at NVIDIA and PhD candidate at Carnegie Mellon University researching LLM inference optimization, deep learning accelerators, neuromorphic computing, and unary arithmetic.',
      worksFor: {
        '@type': 'Organization',
        name: 'NVIDIA',
        url: 'https://www.nvidia.com/',
      },
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'Carnegie Mellon University',
      },
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Carnegie Mellon University',
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'SRM Institute of Science and Technology',
        },
      ],
      knowsAbout: [
        'LLM inference optimization',
        'deep learning accelerators',
        'neuromorphic computing',
        'Temporal Neural Networks',
        'unary arithmetic',
        'hardware-software co-design',
        'computer architecture',
        'VLSI',
      ],
      sameAs: [
        'https://github.com/prabsy96',
        'https://scholar.google.com/citations?user=ePfYSNsAAAAJ',
        'https://linkedin.com/in/pvellais',
      ],
      mainEntityOfPage: Astro.site?.toString(),
    },
    {
      '@type': 'WebSite',
      name: 'Prabhu Vellaisamy',
      url: Astro.site?.toString(),
      description: pageDescription,
      inLanguage: 'en-US',
    },
  ],
};
const mergedStructuredData =
  additionalStructuredData
    ? {
        '@context': 'https://schema.org',
        '@graph': [...structuredData['@graph'], additionalStructuredData],
      }
    : structuredData;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={siteKeywords.join(', ')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Prabhu Vellaisamy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(mergedStructuredData)} />
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script
          is:inline
          set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', ${JSON.stringify(gaMeasurementId)}, { anonymize_ip: true });
          `}
        />
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar />
    <main id="main-content" class={wide ? 'container-wide' : 'container'}>
      <div class="academic-shell">
        <ProfileSidebar />
        <div class="academic-content">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1000;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-bg-card);
    color: var(--color-heading);
    font-weight: 400;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  main {
    min-height: calc(100vh - 200px);
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .academic-shell {
    display: grid;
    grid-template-columns: 180px minmax(0, 760px);
    gap: 56px;
    align-items: start;
    justify-content: center;
  }

  .academic-content {
    width: 100%;
    min-width: 0;
    max-width: 760px;
  }

  @media (max-width: 900px) {
    main {
      padding-top: var(--space-8);
    }

    .academic-shell {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .academic-content {
      max-width: none;
    }
  }
</style>
