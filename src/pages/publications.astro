---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationCounts, publications } from '../data/publications';

const preprintOrder = ['neutnns-arxiv-2026', 'agraph-arxiv-2026'];
const preprints = publications
  .filter((entry) => entry.category === 'preprint')
  .sort((a, b) => preprintOrder.indexOf(a.slug) - preprintOrder.indexOf(b.slug));
const peerReviewed = publications.filter((entry) => entry.category === 'peer-reviewed');
const workshops = publications.filter((entry) => entry.category === 'workshop');
const publicationNumberBySlug = new Map(
  publications.map((publication, index) => [publication.slug, index + 1]),
);
const groups = [
  {
    id: 'peer-reviewed',
    title: 'Peer-Reviewed Papers',
    lead: 'Papers spanning LLM systems, low-power accelerators, and neuromorphic hardware.',
    entries: peerReviewed,
  },
  {
    id: 'preprints',
    title: 'Preprints',
    lead: 'Manuscripts currently available in preprint form.',
    entries: preprints,
  },
  {
    id: 'workshops',
    title: 'Workshop Papers',
    lead: 'Workshop papers that helped shape the larger research program.',
    entries: workshops,
  },
];
---

<BaseLayout
  title="Publications"
  description={`Publications by Prabhu Vellaisamy, including ${publicationCounts.peerReviewed} peer-reviewed papers, ${publicationCounts.workshops} workshop papers, and ${publicationCounts.preprints} preprints.`}
>
  <header class="publication-hero page-header">
    <div class="publication-hero-copy">
      <h1>Publications</h1>
      <p class="subtitle hero-blurb">
        A record of {publicationCounts.peerReviewed} peer-reviewed papers,
        {publicationCounts.workshops} workshop papers, and {publicationCounts.preprints} preprints.
        Links point to available publication records.
      </p>
    </div>
  </header>

  <div class="pub-toolbar" aria-label="Publication filters">
    <button class="pub-filter is-active" type="button" data-filter="all" aria-pressed="true">All</button>
    <button class="pub-filter" type="button" data-filter="peer-reviewed" aria-pressed="false">Peer-reviewed</button>
    <button class="pub-filter" type="button" data-filter="workshops" aria-pressed="false">Workshops</button>
    <button class="pub-filter" type="button" data-filter="preprints" aria-pressed="false">Preprints</button>
  </div>

  <div class="publication-groups">
    {groups.map((group) => (
      <details class="pub-group section" data-pub-group={group.id} open>
        <summary class="pub-group-summary">
          <div class="section-header">
            <h2 class="section-title">{group.title}</h2>
            <p class="section-lead">{group.lead}</p>
          </div>
        </summary>
        <div class="pub-group-body">
          {group.entries.map((publication) => (
            <article
              class="publication"
              data-publication-number={publicationNumberBySlug.get(publication.slug)}
            >
              <h3 class="publication-title">
                <span>{publication.title}</span>
              </h3>
              <p class="publication-authors">
                {publication.authors.split(/(P\. Vellaisamy)/).map((part) =>
                  part === 'P. Vellaisamy' ? <strong>{part}</strong> : part
                )}
              </p>
              <p class="publication-venue">
                <span class="publication-venue-name">{publication.venue}</span>
                {publication.externalUrl && (
                  <a href={publication.externalUrl} target="_blank" rel="noopener noreferrer">
                    {publication.externalLabel ?? 'Publication record'}
                  </a>
                )}
              </p>
              {publication.badge && (
                <p class="publication-badge-row">
                  <span class:list={['badge', publication.category === 'preprint' ? 'badge-review' : 'badge-award']}>
                    {publication.badge}
                  </span>
                </p>
              )}
            </article>
          ))}
        </div>
      </details>
    ))}
  </div>
</BaseLayout>

<style>
  .publication-hero {
    display: block;
  }

  .hero-blurb {
    max-width: 64ch;
  }

  .pub-toolbar {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .pub-filter {
    appearance: none;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-text);
    border-radius: 0;
    padding: 0 0 var(--space-2);
    margin-bottom: -1px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 425;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .pub-filter:hover,
  .pub-filter.is-active {
    color: var(--color-link);
  }

  .pub-filter.is-active {
    border-color: var(--color-link);
  }

  .pub-group {
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  .pub-group + .pub-group {
    margin-top: var(--space-5);
  }

  .pub-group-summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-3) 0;
  }

  .pub-group-summary::-webkit-details-marker {
    display: none;
  }

  .pub-group-summary:hover .section-title {
    color: var(--color-link);
  }

  .section-header {
    margin-bottom: var(--space-3);
  }

  .section-title {
    margin-bottom: var(--space-1);
  }

  .section-lead {
    margin: 0;
    color: var(--color-text-light);
    max-width: 68ch;
    line-height: 1.65;
  }

  .pub-group-body {
    padding: 0 0 var(--space-4);
  }

  .publication {
    position: relative;
    padding: var(--space-4) 0 var(--space-5) var(--space-8);
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--color-border-light);
    background: transparent;
  }

  .publication::before {
    content: '[' attr(data-publication-number) ']';
    position: absolute;
    top: calc(var(--space-4) + 0.15rem);
    left: 0;
    color: var(--color-text-muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .publication-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .publication-title > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .publication-authors {
    margin-bottom: var(--space-1);
    color: var(--color-text-light);
    font-size: 14.5px;
    line-height: 1.5;
  }

  .publication-venue {
    display: grid;
    gap: var(--space-2);
    margin-bottom: 0;
    color: var(--color-text-light);
    font-size: 14px;
  }

  .publication-venue-name {
    min-width: 0;
  }

  .publication-badge-row {
    margin: var(--space-2) 0 0;
    line-height: 1.4;
  }

  .publication-badge-row .badge {
    font-size: 12.5px;
    padding: 0.12rem 0.45rem;
  }

  @media (max-width: 640px) {
    .pub-toolbar {
      gap: var(--space-4);
    }

    .publication {
      padding-left: var(--space-6);
    }
  }
</style>

<script>
  const filters = Array.from(document.querySelectorAll('.pub-filter'));
  const groups = Array.from(document.querySelectorAll('.pub-group'));

  function applyFilter(filter) {
    groups.forEach((group) => {
      const matches = filter === 'all' || group.dataset.pubGroup === filter;
      group.hidden = !matches;
      if (matches) {
        group.open = true;
      }
    });

    filters.forEach((button) => {
      const active = button.dataset.filter === filter;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  }

  filters.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all'));
  });
</script>
