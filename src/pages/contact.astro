---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Contact" description="Contact Prabhu Vellaisamy, an NVIDIA Silicon CoDesign Engineer and CMU ECE PhD candidate, for research inquiries and collaboration.">
  <header class="page-header">
    <h1>Contact</h1>
    <p class="subtitle">Research inquiries and collaborations.</p>
  </header>

  <section class="section">
    <p>
      I'm always happy to hear from fellow researchers and others interested in my work
      on LLM inference, hardware accelerators, or neuromorphic computing.
      Feel free to reach out through any of the channels below.
    </p>

    <div class="contact-info">
      <div class="contact-item">
        <h3>Email</h3>
        <p>
          <a href="mailto:pvellais@andrew.cmu.edu">pvellais@andrew.cmu.edu</a>
        </p>
        <p class="contact-note">Preferred channel for research inquiries and collaborations.</p>
      </div>

      <div class="contact-item">
        <h3>Online Profiles</h3>
        <ul class="profile-links">
          <li><a href="https://github.com/prabsy96" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://scholar.google.com/citations?user=ePfYSNsAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a></li>
          <li><a href="https://linkedin.com/in/pvellais" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </div>

      <div class="contact-item">
        <h3>CV</h3>
        <p>
          <a href={`${base}resume.pdf`}>Download CV (PDF)</a>
        </p>
        <p class="contact-note">Updated July 2026.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Response Time</h2>
    <p>
      I try to respond to all emails within a week. If you haven't heard back,
      feel free to send a follow-up. For urgent matters, please mention it in
      your subject line.
    </p>
  </section>
</BaseLayout>

<style>
  .contact-info {
    display: grid;
    gap: 0;
    margin-top: var(--spacing-lg);
  }

  .contact-item h3 {
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
    font-size: 1.1rem;
  }

  .contact-item {
    min-width: 0;
    padding: var(--space-5) 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
  }

  .contact-item p {
    margin: 0 0 var(--spacing-xs) 0;
  }

  .contact-note {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .profile-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .profile-links li {
    margin: 0;
  }

</style>
