---
import BaseLayout from '../layouts/BaseLayout.astro';

const allNews = [
  // 2026
  {
    year: '2026',
    date: 'Jul 2026',
    title: 'Joined NVIDIA full-time as a Silicon CoDesign Engineer',
    description: 'Accepted and started a full-time Silicon CoDesign Engineer role at NVIDIA Corporation in Santa Clara, CA in July 2026, while continuing the PhD program at Carnegie Mellon University.',
  },
  {
    year: '2026',
    date: 'Mar 2026',
    title: 'TaxBreak published at ISPASS 2026',
    description: '"TaxBreak: Unmasking the Hidden Costs of LLM Inference Through Overhead Decomposition" was published at IEEE ISPASS 2026 and presented on April 27, 2026. The paper is also available on arXiv (arXiv:2603.12465).',
  },
  {
    year: '2026',
    date: 'Mar 2026',
    title: 'Started Silicon Solution Engineering Internship at NVIDIA',
    description: 'Started the Silicon Solution Engineering Intern role at NVIDIA Corporation in Santa Clara, CA for Mar 2026 to Jun 2026.',
  },
  {
    year: '2026',
    date: 'Feb 2026',
    title: 'Preprint: NeuroAI Temporal Neural Networks (NeuTNNs)',
    description: '"NeuroAI Temporal Neural Networks (NeuTNNs): Microarchitecture and Design Framework for Specialized Neuromorphic Processing Units" posted to arXiv (arXiv:2602.01546). Proposes NeuTNNs with active dendrites; NeuTNNGen achieves 30–50% synapse count reduction.',
  },
  {
    year: '2026',
    date: 'Feb 2026',
    title: 'Preprint: A-Graph — Unified Graph Representation for Cross-Stack Simulation',
    description: '"A-Graph: A Unified Graph Representation for At-Will Simulation across System Stacks" posted to arXiv (arXiv:2602.04847).',
  },
  {
    year: '2026',
    date: 'Jan 2026',
    title: 'Paper accepted at ASPLOS 2026',
    description: '"Mugi: Value Level Parallelism for Efficient LLMs" accepted at ACM ASPLOS 2026. Joint work with D. Price, J.P. Shen, and D. Wu.',
  },
  {
    year: '2026',
    date: 'Jan 2026',
    title: 'Two Workshop Papers accepted at ASPLOS 2026 WUC',
    description: '"Mugi: Value Level Parallelism For Nonlinear Operations in LLMs" and "Agraph: A Unified Graph Representation for At-Will Simulation of Emerging Stacks" accepted at Workshop on Unary Computing (WUC), ASPLOS 2026.',
  },
  // 2025
  {
    year: '2025',
    date: 'Jul 2025',
    title: 'Amar Mukherjee Best Paper Award — ISVLSI 2025',
    description: 'Received the Amar Mukherjee Best Paper Award at IEEE ISVLSI 2025 for "Catwalk: Unary Top-K for Efficient Ramp-No-Leak Neuron Design for Temporal Neural Networks."',
  },
  {
    year: '2025',
    date: 'May 2025',
    title: 'Invited Talk at Jülich Supercomputing Center',
    description: 'Gave an invited talk at the Jülich Supercomputing Center, Jülich, Germany (remote) on "Characterizing and Optimizing LLM Inference Workloads on CPU-GPU Coupled Architectures."',
  },
  {
    year: '2025',
    date: 'May 2025',
    title: 'Paper presented at ISPASS 2025, Ghent, Belgium',
    description: 'Presented "Characterizing and Optimizing LLM Inference Workloads on CPU-GPU Coupled Architectures" at IEEE ISPASS 2025.',
  },
  {
    year: '2025',
    date: 'Apr 2025',
    title: 'Paper presented at DATE 2025, Lyon, France',
    description: 'Presented "Tempus Core: Area-Power Efficient Temporal-Unary Convolution Core for Low-Precision Edge DLAs" at IEEE DATE 2025.',
  },
  {
    year: '2024',
    date: '2024',
    title: 'TNNGen published in TCAS-II and presented at ISCAS 2024',
    description: '"TNNGen: Automated Design of Neuromorphic Sensory Processing Units for Time-Series Clustering" was published in IEEE TCAS-II: Express Briefs and presented at ISCAS 2024.',
  },
  // 2023
  {
    year: '2023',
    date: 'Oct 2023',
    title: 'Qualcomm Innovation Fellowship — North America',
    description: 'Received the 2023 Qualcomm Innovation Fellowship - North America.',
  },
];

const years = [...new Set(allNews.map(n => n.year))].sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="News" description="Latest news and updates from Prabhu Vellaisamy.">
  <header class="news-hero page-header">
    <h1>News</h1>
    <p class="subtitle">Announcements, milestones, and publication updates from the research program.</p>
  </header>

  {years.map(year => (
    <section class="section">
      <h2 class="section-title">{year}</h2>
      <ul class="news-list">
        {allNews.filter(n => n.year === year).map(news => (
          <li class="news-item">
            <span class="news-date">{news.date}</span>
            <div class="news-content">
              <div class="news-headline">{news.title}</div>
              <div class="news-body">{news.description}</div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
.news-hero {
  display: block;
}

.news-hero h1 {
  margin: 0 0 var(--space-2);
}

.news-hero .subtitle {
  margin: 0;
  color: var(--color-text-light);
  max-width: 64ch;
  line-height: 1.65;
}

.news-headline {
  font-weight: 500;
  color: var(--color-heading);
  font-size: 1rem;
  margin-bottom: var(--space-1);
}

.news-body {
  font-size: 15px;
  color: var(--color-text-light);
  line-height: 1.6;
}

</style>
