---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Home"
  description="Prabhu Vellaisamy is a Silicon CoDesign Engineer at NVIDIA and a CMU ECE PhD candidate researching LLM inference optimization, deep learning accelerators, and unary computing."
  image="/assets/cmu-campus.webp"
  wide={true}
>
  <figure class="campus-banner">
    <img
      src={`${base}assets/cmu-campus.webp`}
      alt="Carnegie Mellon University campus"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <section class="home-section home-intro">
    <h1>About</h1>
    <p>
      I am a Silicon CoDesign Engineer at NVIDIA and a PhD candidate in Electrical &amp; Computer
      Engineering at Carnegie Mellon University, co-advised by
      <a href="https://users.ece.cmu.edu/~jpshen/" target="_blank" rel="noopener noreferrer">Prof. John Paul Shen</a>
      and
      <a href="https://www.ece.cmu.edu/directory/bios/blanton-ronald.html" target="_blank" rel="noopener noreferrer">Prof. Shawn Blanton</a>.
      I joined NVIDIA full-time in July 2026 after completing a Silicon Solution Engineering
      Internship there from March to June 2026. I remain a PhD candidate at CMU, with expected
      completion in January 2027.
    </p>
    <p>
      My research spans LLM inference optimization on CPU-GPU coupled architectures,
      energy-efficient deep learning accelerators, and neuromorphic computing with Temporal
      Neural Networks. I received the 2023 Qualcomm Innovation Fellowship and the CIT Dean's
      Fellowship.
    </p>
  </section>

  <section class="home-section">
    <h2>Research Focus</h2>
    <div class="research-focus">
      <p><span>LLM systems</span> CPU-GPU coupled inference, orchestration overhead, workload characterization, and performance optimization.</p>
      <p><span>AI accelerators</span> Energy-efficient GEMM, convolution, and MAC architectures for low-precision deep learning.</p>
      <p><span>Neuromorphic hardware</span> Temporal Neural Networks, unary arithmetic, automated PyTorch-to-layout design flows, and custom PDK extensions.</p>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading-row">
      <h2>News</h2>
      <a href={`${base}news`}>All news</a>
    </div>
    <ul class="compact-news">
      <li>
        <time datetime="2026-07">2026/07</time>
        <span>Joined NVIDIA full-time as a Silicon CoDesign Engineer in Santa Clara, California.</span>
      </li>
      <li>
        <time datetime="2026-03">2026/03</time>
        <span><a href={`${base}publications/taxbreak-ispass-2026`}>TaxBreak</a> accepted at IEEE ISPASS 2026 after peer review, with a presentation date of April 27, 2026.</span>
      </li>
      <li>
        <time datetime="2026-03">2026/03</time>
        <span>Started a Silicon Solution Engineering Internship at NVIDIA in Santa Clara, California.</span>
      </li>
      <li>
        <time datetime="2026-01">2026/01</time>
        <span><a href={`${base}publications/mugi-asplos-2026`}>Mugi</a> accepted at ACM ASPLOS 2026.</span>
      </li>
      <li>
        <time datetime="2025-07">2025/07</time>
        <span>Received the Amar Mukherjee Best Paper Award at IEEE ISVLSI 2025 for the Catwalk paper.</span>
      </li>
    </ul>
  </section>

  <section class="home-section">
    <div class="section-heading-row">
      <h2>Selected Publications</h2>
      <a href={`${base}publications`}>All publications</a>
    </div>

    <ol class="selected-publications">
      <li>
        <a class="paper-title" href={`${base}publications/taxbreak-ispass-2026`}>
          TaxBreak: Unmasking the Hidden Costs of LLM Inference Through Overhead Decomposition
        </a>
        <span class="paper-authors">P. Vellaisamy, S. Tripathi, V. Natarajan, S.S. Thenarasu, R.D.S. Blanton, J.P. Shen</span>
        <span class="paper-venue">IEEE ISPASS 2026 · Accepted</span>
      </li>
      <li>
        <a class="paper-title" href={`${base}publications/mugi-asplos-2026`}>
          Mugi: Value Level Parallelism For Efficient LLMs
        </a>
        <span class="paper-authors">D. Price, P. Vellaisamy, J.P. Shen, D. Wu</span>
        <span class="paper-venue">ACM ASPLOS 2026</span>
      </li>
      <li>
        <a class="paper-title" href={`${base}publications/llm-inference-cpu-gpu-ispass-2025`}>
          Characterizing and Optimizing LLM Inference Workloads on CPU-GPU Coupled Architectures
        </a>
        <span class="paper-authors">P. Vellaisamy, T. Labonte, S. Chakraborty, M. Turner, S. Sury, J.P. Shen</span>
        <span class="paper-venue">IEEE ISPASS 2025</span>
      </li>
      <li>
        <a class="paper-title" href={`${base}publications/tempus-core-date-2025`}>
          Tempus Core: Area-Power Efficient Temporal-Unary Convolution Core for Low-Precision Edge DLAs
        </a>
        <span class="paper-authors">P. Vellaisamy, H. Nair, T. Kang, Y. Ni, H. Fan, B. Qi, J. Chen, R.D.S. Blanton, J.P. Shen</span>
        <span class="paper-venue">IEEE DATE 2025</span>
      </li>
      <li>
        <a class="paper-title" href={`${base}publications/catwalk-isvlsi-2025`}>
          Catwalk: Unary Top-K for Efficient Ramp-No-Leak Neuron Design for Temporal Neural Networks
        </a>
        <span class="paper-authors">D. Lister, P. Vellaisamy, J.P. Shen, D. Wu</span>
        <span class="paper-venue">IEEE ISVLSI 2025 · Amar Mukherjee Best Paper Award</span>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  .campus-banner {
    margin: 0 0 var(--space-8);
    overflow: hidden;
    border-top: 2px solid var(--color-accent);
    border-bottom: 1px solid var(--color-border-strong);
    border-radius: 0;
  }

  .campus-banner img {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 1;
    max-height: 132px;
    object-fit: cover;
    object-position: center 48%;
    border-radius: 0;
  }

  .home-section {
    margin-bottom: var(--space-10);
  }

  .home-section h1,
  .home-section h2 {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .home-section h1 {
    font-size: 2rem;
  }

  .home-section h2 {
    font-size: 1.45rem;
  }

  .home-section p {
    max-width: 72ch;
    color: var(--color-text);
  }

  .home-intro {
    font-size: 1rem;
  }

  .research-focus {
    display: grid;
    gap: var(--space-3);
  }

  .research-focus p {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border-strong);
    font-size: 1rem;
  }

  .research-focus span {
    display: inline;
    margin-right: var(--space-2);
    color: var(--color-heading);
    font-family: var(--font-serif);
  }

  .section-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-3);
  }

  .section-heading-row h2 {
    flex: 1;
    margin: 0;
    border: 0;
  }

  .section-heading-row > a {
    flex-shrink: 0;
    font-size: 0.82rem;
  }

  .compact-news {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compact-news li {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-2) 0;
    margin: 0;
    border-bottom: 1px solid var(--color-border-light);
    font-size: 15px;
    line-height: 1.55;
  }

  .compact-news time {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .selected-publications {
    list-style: none;
    counter-reset: papers;
    margin: 0;
    padding: 0;
  }

  .selected-publications li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: var(--space-3) 0 var(--space-3) var(--space-8);
    margin: 0;
    border-bottom: 1px solid var(--color-border-light);
    counter-increment: papers;
  }

  .selected-publications li::before {
    content: '[' counter(papers) ']';
    position: absolute;
    left: 0;
    top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .paper-title {
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .paper-title:hover {
    color: var(--color-link);
  }

  .paper-authors,
  .paper-venue {
    color: var(--color-text-light);
    font-size: 14px;
    line-height: 1.5;
  }

  .paper-venue {
    color: var(--color-link);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .campus-banner {
      margin-bottom: var(--space-6);
    }

    .campus-banner img {
      aspect-ratio: 3.2 / 1;
    }

    .home-section {
      margin-bottom: var(--space-8);
    }

    .home-section h1 {
      font-size: 1.8rem;
    }

    .compact-news li {
      grid-template-columns: 4.6rem minmax(0, 1fr);
      gap: var(--space-2);
    }

    .section-heading-row {
      align-items: center;
    }
  }
</style>
