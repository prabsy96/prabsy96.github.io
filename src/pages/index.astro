---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Home"
  description="Prabhu Vellaisamy is a Silicon CoDesign Engineer at NVIDIA and a CMU ECE PhD candidate researching LLM inference optimization, deep learning accelerators, and unary computing."
  image="/assets/cmu-campus.webp"
  wide={true}
>

  <!-- ── Hero ───────────────────────────────────── -->
  <section class="hero">
    <figure class="hero-banner">
      <img
        src={`${base}assets/cmu-campus.webp`}
        alt="Carnegie Mellon University campus"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="hero-grid">
      <div class="hero-body">
        <div class="hero-text">
          <p class="hero-eyebrow">Silicon CoDesign Engineer · NVIDIA &nbsp;|&nbsp; PhD Candidate · Carnegie Mellon University</p>
          <h1>Prabhu Vellaisamy</h1>
          <p class="hero-bio">
            I am a Silicon CoDesign Engineer at NVIDIA and a PhD candidate in
            Electrical &amp; Computer Engineering at CMU, co-advised by
            <a href="https://users.ece.cmu.edu/~jpshen/" target="_blank" rel="noopener noreferrer">Prof. John Paul Shen</a> and
            <a href="https://www.ece.cmu.edu/directory/bios/blanton-ronald.html" target="_blank" rel="noopener noreferrer">Prof. Shawn Blanton</a>.
            My research spans LLM inference optimization on CPU-GPU coupled architectures,
            energy-efficient deep learning accelerators, and neuromorphic computing with Temporal Neural Networks.
            I received the 2023 Qualcomm Innovation Fellowship and the CIT Dean's Fellowship.
          </p>
          <p class="hero-bio">
            I joined NVIDIA full-time in July 2026 after completing a Silicon Solution Engineering Internship
            at NVIDIA from March to June 2026. Expected PhD completion: January 2027.
          </p>
          <div class="hero-links">
            <a href={`${base}resume.pdf`} class="btn">Download CV</a>
            <a href={`${base}research`} class="btn btn-outline">Research</a>
            <a href={`${base}publications`} class="btn btn-outline">Publications</a>
          </div>
          <div class="hero-socials">
            <a href="mailto:pvellais@andrew.cmu.edu" title="Email">pvellais@andrew.cmu.edu</a>
            <span class="sep">·</span>
            <a href="https://scholar.google.com/citations?user=ePfYSNsAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
            <span class="sep">·</span>
            <a href="https://github.com/prabsy96" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span class="sep">·</span>
            <a href="https://linkedin.com/in/pvellais" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>
      </div>

      <aside class="hero-visual" aria-label="Profile image">
        <figure class="portrait-card">
          <img
            src={`${base}assets/profile-headshot.jpeg`}
            alt="Prabhu Vellaisamy headshot"
            width="800"
            height="800"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </aside>
    </div>
  </section>

  <!-- ── Stats ─────────────────────────────────── -->
  <div class="stats-grid">
    <div class="stat-item">
      <div class="stat-number">12</div>
      <div class="stat-label">Peer-Reviewed Papers</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">5</div>
      <div class="stat-label">Workshop Papers</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">6</div>
      <div class="stat-label">Conference Talks</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">10</div>
      <div class="stat-label">Teaching Semesters</div>
    </div>
  </div>

  <!-- ── Research Interests ────────────────────── -->
  <section class="section">
    <h2 class="section-title">Research Interests</h2>
    <p class="section-lead">
      My work sits at the intersection of systems, architecture, and physical implementation: from LLM inference behavior on coupled CPU-GPU platforms to low-power accelerator design and neuromorphic hardware generation.
    </p>
    <div class="interests-grid">
      <div class="interest-card">
        <div class="interest-index">01</div>
        <div>
          <h3 class="interest-title">LLM Inference Optimization</h3>
          <p class="interest-desc">Profiling and optimizing LLM workloads on CPU-GPU coupled architectures (H100, GH200). KV cache efficiency, batching strategies, kernel-level bottleneck decomposition.</p>
        </div>
      </div>
      <div class="interest-card">
        <div class="interest-index">02</div>
        <div>
          <h3 class="interest-title">Deep Learning Accelerator Design</h3>
          <p class="interest-desc">Custom GEMM units, convolution cores, and MAC architectures targeting edge AI — leveraging unary/binary hybrid arithmetic for area-power-efficiency trade-offs.</p>
        </div>
      </div>
      <div class="interest-card">
        <div class="interest-index">03</div>
        <div>
          <h3 class="interest-title">Neuromorphic Computing</h3>
          <p class="interest-desc">Temporal Neural Networks (TNNs), automated RTL-to-GDSII design frameworks, and custom PDK development for neuromorphic sensory processing.</p>
        </div>
      </div>
      <div class="interest-card">
        <div class="interest-index">04</div>
        <div>
          <h3 class="interest-title">VLSI / ASIC Design</h3>
          <p class="interest-desc">Physical design, floorplanning, clock tree synthesis, and DRC/LVS signoff using TSMC N5 and predictive ASAP7 process technologies. Hardware-software co-design for AI workloads.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Recent News ───────────────────────────── -->
  <section class="section">
    <h2 class="section-title">Recent News</h2>
    <p class="section-lead">
      Recent paper acceptances, invited talks, awards, and industry research appointments.
    </p>
    <ul class="news-list">
      <li class="news-item">
        <span class="news-date">Jul 2026</span>
        <span class="news-content">Joined NVIDIA full-time as a Silicon CoDesign Engineer in Santa Clara, CA.</span>
      </li>
      <li class="news-item">
        <span class="news-date">Mar 2026</span>
        <span class="news-content">Started a Silicon Solution Engineering Internship at NVIDIA Corporation, Santa Clara, CA.</span>
      </li>
      <li class="news-item">
        <span class="news-date">Jan 2026</span>
        <span class="news-content">Paper <em>"Mugi: Value Level Parallelism for Efficient LLMs"</em> accepted at ASPLOS 2026.</span>
      </li>
      <li class="news-item">
        <span class="news-date">Jul 2025</span>
        <span class="news-content">Received the Amar Mukherjee Best Paper Award at ISVLSI 2025 for the Catwalk paper.</span>
      </li>
      <li class="news-item">
        <span class="news-date">May 2025</span>
        <span class="news-content">Invited talk at Jülich Supercomputing Center, Forschungszentrum Jülich in Germany on LLM inference optimization on CPU-GPU coupled architectures.</span>
      </li>
      <li class="news-item">
        <span class="news-date">May 2025</span>
        <span class="news-content">Paper presented at ISPASS 2025, Ghent, Belgium: "Characterizing and Optimizing LLM Inference Workloads on CPU-GPU Coupled Architectures."</span>
      </li>
      <li class="news-item">
        <span class="news-date">Apr 2025</span>
        <span class="news-content">Paper presented at DATE 2025, Lyon, France: "Tempus Core: Area-Power Efficient Temporal-Unary Convolution Core."</span>
      </li>
    </ul>
    <p class="more-link"><a href={`${base}news`}>View all news →</a></p>
  </section>

  <!-- ── Selected Publications ─────────────────── -->
  <section class="section">
    <h2 class="section-title">Selected Publications</h2>
    <p class="section-lead">
      Representative papers across LLM systems, accelerator architecture, and temporal neuromorphic hardware.
    </p>

    <div class="publication-showcase">
    <div class="publication card home-publication-card featured-publication">
      <p class="publication-title">
        TaxBreak: Unmasking the Hidden Costs of LLM Inference Through Overhead Decomposition
      </p>
      <p class="publication-authors">P. Vellaisamy, S. Tripathi, V. Natarajan, S.S. Thenarasu, R.D.S. Blanton, J.P. Shen</p>
      <p class="publication-venue">
        <em>IEEE ISPASS 2026</em>
        <span class="badge badge-journal">Accepted</span>
      </p>
      <p class="pub-summary">A decomposition of LLM inference overheads that isolates non-matmul costs, exposes where end-to-end latency is lost, and helps redirect optimization effort toward the bottlenecks large-model deployments actually pay for.</p>
    </div>

    <div class="publication card home-publication-card">
      <p class="publication-title">
        Mugi: Value Level Parallelism for Efficient LLMs
      </p>
      <p class="publication-authors">D. Price, P. Vellaisamy, J.P. Shen, D. Wu</p>
      <p class="publication-venue">
        <em>ACM ASPLOS 2026</em>
        <span class="badge badge-journal">Systems</span>
      </p>
      <p class="pub-summary">Generalizes value-level parallelism (VLP) for nonlinear LLM operations and small-batch GEMMs. Up to 45× throughput and 668× energy efficiency for softmax; 2.07× LLM throughput and 3.11× energy efficiency; 1.45× reduction in operational carbon.</p>
    </div>

    <div class="publication card home-publication-card">
      <p class="publication-title">
        Characterizing and Optimizing LLM Inference Workloads on CPU-GPU Coupled Architectures
      </p>
      <p class="publication-authors">P. Vellaisamy, T. Labonte, S. Chakraborty, M. Turner, S. Sury, J.P. Shen</p>
      <p class="publication-venue">
        <em>IEEE ISPASS 2025</em>
        <span class="badge badge-talk">Invited Talk at Jülich Supercomputing Center</span>
      </p>
      <p class="pub-summary">Characterizes prefill/decode bottlenecks on H100 vs GH200: GH200 incurs 2.8× higher prefill latency and 4× larger CPU-bounded region. Samsung-funded ($100K+).</p>
    </div>

    <div class="publication card home-publication-card">
      <p class="publication-title">
        Tempus Core: Area-Power Efficient Temporal-Unary Convolution Core for Low-Precision Edge DLAs
      </p>
      <p class="publication-authors">P. Vellaisamy, H. Nair, T. Kang, Y. Ni, H. Fan, B. Qi, H.F. Hung, J. Chen, R.D.S. Blanton, J.P. Shen</p>
      <p class="publication-venue"><em>IEEE DATE 2025</em></p>
      <p class="pub-summary">INT8 temporal-unary convolution core for NVDLA: 53% area reduction, 44% power savings, and 5× iso-area throughput improvement.</p>
    </div>

    <div class="publication card home-publication-card">
      <p class="publication-title">
        Catwalk: Unary Top-K for Efficient Ramp-No-Leak Neuron Design for Temporal Neural Networks
      </p>
      <p class="publication-authors">D. Lister, P. Vellaisamy, J.P. Shen, D. Wu</p>
      <p class="publication-venue">
        <em>IEEE ISVLSI 2025</em>
        <span class="badge badge-award">Best Paper Award</span>
      </p>
      <p class="pub-summary">Introduces a unary top-k design for Temporal Neural Networks that improves ramp-no-leak neuron efficiency and earned the Amar Mukherjee Best Paper Award at ISVLSI 2025.</p>
    </div>
    </div>

    <p class="more-link"><a href={`${base}publications`}>View all 12 peer-reviewed papers + 5 workshop papers →</a></p>
  </section>

  <!-- ── Education ─────────────────────────────── -->
  <section class="section">
    <h2 class="section-title">Education</h2>
    <div class="timeline">

      <div class="timeline-item">
        <div class="timeline-dot current"></div>
        <div class="timeline-period">Sep 2021 – Jan 2027 (Expected)</div>
        <div class="timeline-title">Doctor of Philosophy, Electrical &amp; Computer Engineering</div>
        <div class="timeline-org">Carnegie Mellon University — Pittsburgh, PA</div>
        <div class="timeline-body">
          Advisors: Prof. J.P. Shen &amp; Prof. Shawn Blanton · CMU NCAL, CMU ACTL, UCF UNARY Research Groups.<br>
          CIT Dean's Fellowship. 2023 Qualcomm Innovation Fellowship.
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-period">Jan 2020 – May 2021</div>
        <div class="timeline-title">Master of Science, Electrical &amp; Computer Engineering</div>
        <div class="timeline-org">Carnegie Mellon University — Pittsburgh, PA</div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-period">Jun 2014 – Jul 2018</div>
        <div class="timeline-title">Bachelor of Technology, Electrical &amp; Electronics Engineering</div>
        <div class="timeline-org">SRM Institute of Science and Technology — Chennai, India</div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
/* ── Hero ─────────────────────────────────────── */
.hero {
  padding: var(--space-6);
  margin-bottom: var(--space-8);
  border: 1px solid var(--color-border);
  border-top: 2px solid var(--color-accent);
  border-radius: var(--radius-sm);
  background: rgba(255, 253, 249, 0.72);
}

.hero-banner {
  margin: 0 0 var(--space-6);
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid var(--color-border);
  background: #fff;
  box-shadow: none;
}

.hero-banner img {
  display: block;
  width: 100%;
  aspect-ratio: 24 / 5;
  object-fit: cover;
  object-position: center center;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210px;
  gap: var(--space-10);
  align-items: start;
}

.hero-visual {
  display: grid;
  width: 210px;
  justify-self: end;
}

.hero-visual figure {
  margin: 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid var(--color-border);
  background: #fff;
  box-shadow: none;
}

.hero-visual img {
  display: block;
  width: 100%;
  height: auto;
}

.portrait-card img {
  aspect-ratio: 1 / 1;
  object-fit: cover;
  object-position: center top;
}

.campus-card img {
  aspect-ratio: 16 / 9;
  object-fit: cover;
  object-position: center center;
}

.hero-eyebrow {
  font-size: 0.85rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: var(--color-link);
  margin-bottom: var(--space-3);
}

.hero h1 {
  font-size: clamp(2.1rem, 3vw, 2.65rem);
  margin-top: 0;
  margin-bottom: var(--space-5);
  letter-spacing: -0.02em;
}

.hero-bio {
  font-size: 1rem;
  max-width: 76ch;
  color: var(--color-text);
  margin-bottom: var(--space-4);
  line-height: 1.8;
}

.hero-body {
  max-width: 82ch;
}

.hero-links {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-3);
}

.hero-socials {
  font-size: 0.875rem;
  color: var(--color-text-light);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.hero-socials a { color: var(--color-text-light); }
.hero-socials a:hover { color: var(--color-link); }
.sep { color: var(--color-border); }

/* ── Interests ────────────────────────────────── */
.section-lead {
  max-width: 74ch;
  margin: 0 0 var(--space-4);
  color: var(--color-text-light);
  line-height: 1.7;
}

.interests-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  column-gap: var(--space-8);
  row-gap: 0;
}

.interest-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  border-top: 1px solid var(--color-border);
  padding: var(--space-4) 0;
}

.interest-index {
  min-width: 2.4rem;
  color: var(--color-link);
  font-size: 0.8rem;
  font-weight: 400;
  letter-spacing: 0.06em;
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.interest-title {
  font-size: 0.95rem;
  font-weight: 400;
  margin: 0 0 var(--space-2) 0;
  color: var(--color-heading);
}

.interest-desc {
  font-size: 0.875rem;
  color: var(--color-text-light);
  margin: 0;
  line-height: 1.6;
}

/* ── Publications on home ─────────────────────── */
.publication-showcase {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}

.home-publication-card {
  margin-bottom: 0;
  padding: var(--space-4) 0;
  border: 0;
  border-bottom: 1px solid var(--color-border);
  border-radius: 0;
  background: transparent;
}

.featured-publication {
  grid-column: auto;
  padding: var(--space-4) 0;
  background: transparent;
}

.pub-summary {
  font-size: 0.875rem;
  color: var(--color-text-light);
  font-style: italic;
  margin: var(--space-1) 0 0 0;
}

.more-link {
  margin-top: var(--space-4);
  font-size: 0.9rem;
}

/* ── Responsive ──────────────────────────────── */
@media (max-width: 600px) {
  .hero {
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .hero-banner {
    margin-bottom: var(--space-4);
  }

  .hero-banner img {
    aspect-ratio: 16 / 5;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .hero-visual {
    width: 150px;
    justify-self: start;
  }

  .hero h1 { font-size: 2rem; }
  .interests-grid { grid-template-columns: 1fr; }
}
</style>
