  <!-- ── Memberships ─────────────────────────── -->
  <section class="section">
    <h2 class="section-title">Professional Memberships and Honor Societies</h2>
    <ul>
      <li>IEEE-Eta Kappa Nu (HKN).</li>
      <li>Sigma Xi Scientific Research Honor Society.</li>
    </ul>
  </section>

</BaseLayout>

<style>
.section-sub {
  font-size: 0.875rem;
  color: var(--color-text-light);
  margin-bottom: var(--space-4);
  margin-top: calc(-1 * var(--space-4));
}

.section-note {
  font-size: 0.875rem;
  color: var(--color-text-light);
  margin-top: var(--space-3);
}

.teaching-table {
  font-size: 0.9rem;
}

.teaching-table td, .teaching-table th {
  vertical-align: top;
  padding: var(--space-3) var(--space-4);
}

@media (max-width: 600px) {
  .teaching-table { font-size: 13px; }
  .teaching-table td, .teaching-table th { padding: var(--space-2); }
}
</style>
