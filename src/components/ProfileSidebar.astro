---
const base = import.meta.env.BASE_URL;
---

<aside class="profile-sidebar" aria-label="Researcher profile">
  <img
    class="profile-sidebar-photo"
    src={`${base}assets/profile-headshot.jpeg`}
    alt="Prabhu Vellaisamy"
    width="800"
    height="800"
    loading="eager"
  />

  <div class="profile-sidebar-body">
    <h2>Prabhu Vellaisamy</h2>
    <p class="profile-role">Silicon CoDesign Engineer, NVIDIA</p>
    <p class="profile-role">PhD Candidate, Carnegie Mellon University</p>

    <div class="profile-details">
      <p>Santa Clara, CA</p>
      <p><a href="mailto:pvellais@andrew.cmu.edu">pvellais@andrew.cmu.edu</a></p>
    </div>

    <nav class="profile-sidebar-links" aria-label="Academic profiles">
      <a href={`${base}resume.pdf`}>CV</a>
      <a href="https://scholar.google.com/citations?user=ePfYSNsAAAAJ" target="_blank" rel="noopener noreferrer">Scholar</a>
      <a href="https://github.com/prabsy96" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://linkedin.com/in/pvellais" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</aside>

<style>
  .profile-sidebar {
    position: sticky;
    top: 6.5rem;
    align-self: start;
    text-align: center;
  }

  .profile-sidebar-photo {
    display: block;
    width: 152px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    margin: 0 auto var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-bg-card);
  }

  .profile-sidebar h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.28rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .profile-role {
    margin: 0 0 var(--space-1);
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.5;
  }

  .profile-details {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-5) 0;
    font-size: 14px;
    line-height: 1.45;
  }

  .profile-details p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .profile-sidebar-links {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: center;
    gap: var(--space-1) var(--space-4);
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .profile-sidebar {
      position: static;
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: var(--space-5);
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--color-border);
      text-align: left;
    }

    .profile-sidebar-photo {
      width: 88px;
      margin: 0;
    }

    .profile-sidebar h2 {
      font-size: 1.25rem;
    }

    .profile-sidebar-links {
      display: flex;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }
  }

  @media (max-width: 520px) {
    .profile-sidebar {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--space-4);
    }

    .profile-sidebar-photo {
      width: 72px;
    }

    .profile-sidebar h2 {
      font-size: 1.08rem;
    }

    .profile-role,
    .profile-details,
    .profile-sidebar-links {
      font-size: 13px;
    }
  }
</style>
