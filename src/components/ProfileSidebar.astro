---
const base = import.meta.env.BASE_URL;
---

<aside class="profile-sidebar" aria-label="Researcher profile">
  <img
    class="profile-sidebar-photo"
    src={`${base}assets/profile-headshot.jpeg`}
    alt="Prabhu Vellaisamy"
    width="800"
    height="800"
    loading="eager"
  />

  <div class="profile-sidebar-body">
    <h2>Prabhu Vellaisamy</h2>
    <p class="profile-role">Silicon CoDesign Engineer at NVIDIA</p>
    <p class="profile-role">PhD Candidate at Carnegie Mellon University</p>

    <dl class="profile-details">
      <div>
        <dt>Location</dt>
        <dd>Santa Clara, CA / Pittsburgh, PA</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:pvellais@andrew.cmu.edu">pvellais@andrew.cmu.edu</a></dd>
      </div>
    </dl>

    <nav class="profile-sidebar-links" aria-label="Academic profiles">
      <a href={`${base}resume.pdf`}>CV</a>
      <a href="https://scholar.google.com/citations?user=ePfYSNsAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
      <a href="https://github.com/prabsy96" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://linkedin.com/in/pvellais" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</aside>

<style>
  .profile-sidebar {
    position: sticky;
    top: 6.5rem;
    align-self: start;
  }

  .profile-sidebar-photo {
    display: block;
    width: 176px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    margin-bottom: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-bg-card);
  }

  .profile-sidebar h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .profile-role {
    margin: 0 0 var(--space-1);
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .profile-details {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .profile-details div {
    display: grid;
    gap: 0.1rem;
  }

  .profile-details dt {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .profile-details dd {
    margin: 0;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .profile-sidebar-links {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: 0.86rem;
  }

  @media (max-width: 820px) {
    .profile-sidebar {
      position: static;
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      gap: var(--space-5);
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--color-border);
    }

    .profile-sidebar-photo {
      width: 104px;
      margin: 0;
    }

    .profile-sidebar h2 {
      font-size: 1.25rem;
    }

    .profile-details {
      margin: var(--space-3) 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-sidebar-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      padding-top: var(--space-3);
    }
  }

  @media (max-width: 520px) {
    .profile-sidebar {
      grid-template-columns: 84px minmax(0, 1fr);
      gap: var(--space-4);
    }

    .profile-sidebar-photo {
      width: 84px;
    }

    .profile-details {
      grid-template-columns: 1fr;
    }
  }
</style>
