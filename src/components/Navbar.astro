---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: base, label: 'Home' },
  { href: `${base}research`, label: 'Research' },
  { href: `${base}publications`, label: 'Publications' },
  { href: `${base}cv`, label: 'CV' },
  { href: `${base}news`, label: 'News' },
  { href: `${base}contact`, label: 'Contact' },
];

function isActive(href: string, current: string): boolean {
  if (href === base) {
    return current === base || current === `${base}index.html`;
  }
  return current.startsWith(href);
}
---

<header class="navbar">
  <nav class="navbar-container container-wide" aria-label="Primary navigation">
    <a href={base} class="navbar-brand">Prabhu Vellaisamy</a>
    <button class="navbar-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-navigation">
      <span class="hamburger"></span>
    </button>
    <ul class="navbar-links" id="primary-navigation">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href, currentPath) }]}
            aria-current={isActive(link.href, currentPath) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .navbar {
    background: rgba(253, 252, 249, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .navbar-container {
    display: grid;
    grid-template-columns: 180px minmax(0, 760px);
    gap: 56px;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .navbar-brand {
    justify-self: center;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-heading);
    text-decoration: none;
  }

  .navbar-brand:hover {
    color: var(--color-link);
    text-decoration: none;
  }

  .navbar-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--spacing-sm);
  }

  .hamburger {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-text);
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
    left: 0;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    top: 6px;
  }

  .navbar-links {
    display: flex;
    justify-self: end;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
  }

  .nav-link {
    font-size: 15px;
    color: var(--color-text);
    text-decoration: none;
    padding: var(--spacing-xs) var(--space-2);
    border-bottom: 2px solid transparent;
    border-radius: 0;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-link);
    background: transparent;
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-link);
    border-bottom-color: var(--color-link);
    background: transparent;
  }

  @media (max-width: 900px) {
    .navbar-container {
      display: flex;
      justify-content: space-between;
    }

    .navbar-brand {
      justify-self: auto;
    }
  }

  @media (max-width: 600px) {
    .navbar-toggle {
      display: block;
    }

    .navbar-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-bg);
      flex-direction: column;
      padding: var(--spacing-md);
      gap: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .navbar-links.open {
      display: flex;
    }

    .navbar-links li {
      margin: 0;
    }

    .nav-link {
      display: block;
      padding: var(--spacing-sm) 0;
      border-bottom: none;
    }

    .navbar-container {
      position: relative;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.navbar-toggle');
  const links = document.querySelector('.navbar-links');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    links?.classList.remove('open');
  };

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    links?.classList.toggle('open');
  });

  links?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      toggle?.focus();
    }
  });
</script>
