---
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-wide footer-content">
    <p class="copyright">
      &copy; {currentYear} Prabhu Vellaisamy. All rights reserved.
    </p>
    <nav class="footer-links">
      <a href={`${base}resume.pdf`}>CV</a>
      <a href="https://github.com/prabsy96" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://scholar.google.com/citations?user=ePfYSNsAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
      <a href="https://linkedin.com/in/pvellais" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 180px minmax(0, 760px);
    justify-content: center;
    align-items: center;
    column-gap: 56px;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .copyright {
    text-align: center;
    margin: 0;
    font-size: 14px;
    color: var(--color-text-light);
  }

  .footer-links {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-5);
  }

  .footer-links a {
    font-size: 14px;
    color: var(--color-text-light);
  }

  .footer-links a:hover {
    color: var(--color-link);
  }

  @media (max-width: 900px) {
    .footer-content {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
      text-align: center;
    }
  }

  @media (max-width: 520px) {
    .footer-content {
      align-items: center;
      flex-direction: column;
    }
  }
</style>
